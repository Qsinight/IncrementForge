{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals"],
    // 只有 `src/bin.ts` 需要：Node 的 `--experimental-strip-types` 要求 import 写成
    // `./cli.ts`（它不做 bundler 的 `.js` -> `.ts` 映射），而全仓其余代码按 3.2 用 `.js`。
    // 两者共存靠的是这个开关 + `noEmit`（基类已开）。
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
