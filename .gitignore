# 依赖安装
node_modules/
.pnpm-store/

# 构建产物
# 注意：`build/` 必须锚定到仓库根（写成 `/build/`）。不加前导斜杠时该模式会匹配
# 任意层级的同名目录，连源码包 packages/build/ 一起被忽略，导致 CI 缺少该包、
# vite 构建报 `Could not load packages/build/src/index.ts`。
dist/
/build/
*.tsbuildinfo

# 测试与工具缓存
coverage/
.vitest/
packages/*/node_modules/.cache/
apps/*/node_modules/.cache/
test-results/
playwright-report/

# E2E 产物（详见 e2e/.gitignore）
e2e/.artifacts/

# 环境变量与本地密钥（公开仓库不要提交任何 .env）
.env
.env.*
!.env.example

# 日志
*.log
npm-debug.log*
pnpm-debug.log*

# 编辑器本地文件
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
